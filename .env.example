# Kopieren nach ".env" und Werte anpassen.
# docker compose liest .env automatisch ein.

# Host-Pfad des S3-Mounts mit den Musikdateien
MUSIC_HOST_PATH=/path/to/music

# Kostenloser API-Key für Audio-Fingerprinting: https://acoustid.org/new-application
# Optional, aber empfohlen - ohne Key nur unzuverlässige Namens-Erkennung.
ACOUSTID_API_KEY=
