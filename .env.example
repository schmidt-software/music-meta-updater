# Copy to ".env" and adjust the values.
# docker compose reads .env automatically.

# Host path of the mounted folder containing the music files
MUSIC_HOST_PATH=/path/to/music

# Free API key for audio fingerprinting: https://acoustid.org/new-application
# Optional, but recommended - without a key only unreliable filename detection.
ACOUSTID_API_KEY=

# ===== Performance Tuning =====

# Number of files checked concurrently while scanning (default: 8).
# Raise this on high-latency network mounts where each file check is a
# network round trip.
# SCAN_WORKERS=4

# ===== Tagging Behavior =====

# Tagging mode: default, strict, aggressive, cover_only
# - default: balanced confidence threshold (strong_rec_thresh=0.85)
# - strict: high confidence only (strong_rec_thresh=0.95) - fewest false matches
# - aggressive: lower confidence (strong_rec_thresh=0.70) - higher tagging rate
# - cover_only: only fetch/embed covers, no tag updates
# TAGGING_MODE=default

# Custom matching confidence threshold for beets (overrides TAGGING_MODE if set)
# Range: 0.0 to 1.0
# Default depends on TAGGING_MODE:
#   - strict: 0.95
#   - aggressive: 0.70
#   - default: 0.85
#
# Tuning tips:
#   - 0.99: Ultra-conservative (almost no matches)
#   - 0.95: Conservative (strict mode default) - recommended for classical/jazz
#   - 0.85: Balanced (default mode) - recommended for pop/rock
#   - 0.70: Aggressive (aggressive mode) - recommended for compilations
#   - 0.50: Very aggressive (many false positives)
# STRONG_REC_THRESH=0.85

# ===== Recurring Execution =====

# Cron expression for recurring runs (leave empty for one-shot mode)
# Format: "minute hour day month weekday"
# Examples:
#   "0 2 * * *"    - daily at 2 AM
#   "0 */6 * * *"  - every 6 hours
#   "0 0 * * 0"    - weekly on Sunday at midnight
# SCHEDULE=

# ===== Monitoring =====

# Webhook URL for health check notifications (optional)
# JSON metrics are POSTed on completion
# WEBHOOK_URL=https://your-webhook.example.com/notify

# ===== Cover Art Fetching =====

# Cover art sources fallback chain (comma-separated)
# Available sources: musicbrainz, amazon, discogs, local, placeholder
# Default (if not set): musicbrainz,amazon,discogs
# Extended (with cache): musicbrainz,amazon,discogs,local,placeholder
#
# Fallback behavior:
#   - musicbrainz: MusicBrainz Cover Art Archive (highest quality, default)
#   - amazon: Amazon product images (reliable for mainstream albums)
#   - discogs: Discogs user-submitted covers (variable quality)
#   - local: Local cache of previously downloaded covers (offline fallback)
#   - placeholder: Auto-generated placeholder image (last resort)
#
# Examples:
#   COVER_SOURCES=musicbrainz,amazon,discogs
#   COVER_SOURCES=musicbrainz,amazon,discogs,local,placeholder
# COVER_SOURCES=musicbrainz,amazon,discogs
