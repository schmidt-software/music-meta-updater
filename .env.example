# Copy to ".env" and adjust the values.
# docker compose reads .env automatically.

# Host path of the mounted folder containing the music files
MUSIC_HOST_PATH=/path/to/music

# Free API key for audio fingerprinting: https://acoustid.org/new-application
# Optional, but recommended - without a key only unreliable filename detection.
ACOUSTID_API_KEY=

# Optional: number of files checked concurrently while scanning (default 8).
# Raise this on high-latency network mounts where each file check is a
# network round trip.
SCAN_WORKERS=
